{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  // The tests are plain node --test files ported from the phone.
  "exclude": ["src/**/*.test.ts"]
}
