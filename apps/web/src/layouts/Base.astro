---
// Every page's head: title, description, and the link-preview tags that WhatsApp, iMessage, X,
// LinkedIn, Slack, Discord and Facebook read. Image URLs are absolute because crawlers require it.
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Share image, a path under public/. 1200x630. */
  image?: string;
  imageAlt?: string;
  /** Keep a page out of search results (utility pages like the share-card source). */
  noindex?: boolean;
  skipToContent?: boolean;
}

const NAME = "Mates";
const {
  title = "Mates: your AI team in your pocket",
  description = "AI teammates for real days: morning briefs, ride quotes in GHS, meeting notes, missions, and GitHub pull requests. Join the waitlist for iPhone and Android.",
  image = "/og.png",
  imageAlt = "Mates: three phones illustrating AI teammates working together",
  noindex = false,
  skipToContent = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
// Tells search engines what this is: a mobile app, coming to iOS and Android.
const structuredData = {
  "@context": "https://schema.org",
  "@type": "MobileApplication",
  name: NAME,
  url: Astro.site?.href,
  description,
  image: imageUrl,
  applicationCategory: "ProductivityApplication",
  operatingSystem: "iOS, Android",
  offers: { "@type": "Offer", price: "8.00", priceCurrency: "USD" },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap" rel="stylesheet" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body>
    {skipToContent && <a class="skip-link" href="#main-content">Skip to content</a>}
    <slot />
    {
      !noindex && (
        // One cookie-free page view per load, sent in the background. ES5 so any browser runs it.
        <script is:inline define:vars={{ endpoint: `${import.meta.env.PUBLIC_API_URL ?? "https://mates-production.up.railway.app"}/site/visit` }}>
          if (location.hostname !== "localhost" && location.hostname !== "127.0.0.1") {
            try {
              var body = JSON.stringify({ path: location.pathname, referrer: document.referrer });
              if (navigator.sendBeacon) navigator.sendBeacon(endpoint, new Blob([body], { type: "text/plain" }));
              else fetch(endpoint, { method: "POST", body: body, keepalive: true, mode: "no-cors" });
            } catch (e) {}
          }
        </script>
      )
    }
  </body>
</html>
