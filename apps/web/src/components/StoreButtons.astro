---
// App Store and Google Play, used by the hero and the closing call to action. The listings are
// not live yet, so they read "Coming soon" and are not links: nobody taps through to nothing.
interface Props {
  align?: "center" | "start";
}

const { align = "center" } = Astro.props;
---

<div class="ctas" style={`justify-content: ${align === "center" ? "center" : "flex-start"}`}>
  <span class="pill-button dark store" aria-disabled="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M16.37 12.6c-.02-2.3 1.88-3.4 1.96-3.46-1.07-1.56-2.73-1.77-3.32-1.8-1.41-.14-2.76.83-3.48.83-.72 0-1.82-.81-3-.79-1.54.02-2.96.9-3.76 2.27-1.6 2.78-.41 6.9 1.15 9.16.76 1.1 1.67 2.34 2.86 2.3 1.15-.05 1.58-.74 2.97-.74 1.38 0 1.77.74 2.98.72 1.23-.02 2.01-1.12 2.76-2.23.87-1.28 1.23-2.52 1.25-2.58-.03-.01-2.39-.92-2.37-3.68zM14.1 5.86c.63-.77 1.06-1.83.94-2.89-.91.04-2.01.61-2.66 1.37-.58.67-1.09 1.75-.96 2.79 1.02.08 2.05-.52 2.68-1.27z" />
    </svg>
    <span class="label"><small>Coming soon to</small>App Store</span>
  </span>
  <span class="pill-button light store" aria-disabled="true">
    <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M3.6 1.8 13.4 12 3.6 22.2c-.4-.2-.6-.6-.6-1.1V2.9c0-.5.2-.9.6-1.1z" />
      <path d="m16.8 8.6-3.4 3.4 3.4 3.4 3.8-2.2c.8-.5.8-1.7 0-2.2z" opacity="0.75" />
      <path d="M3.6 1.8c.3-.2.8-.2 1.2 0l12 6.8-3.4 3.4z" opacity="0.55" />
      <path d="m13.4 12 3.4 3.4-12 6.8c-.4.2-.9.2-1.2 0z" opacity="0.9" />
    </svg>
    <span class="label"><small>Coming soon to</small>Google Play</span>
  </span>
</div>

<style>
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .store {
    height: 54px;
    padding: 0 22px 0 18px;
    cursor: default;
  }
  .store:active {
    transform: none;
  }
  .store.dark:hover {
    background: var(--text);
  }
  .store.light:hover {
    background: var(--soft);
  }
  .label {
    display: grid;
    text-align: left;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.15;
  }
  small {
    font-size: 11px;
    font-weight: 500;
    opacity: 0.7;
  }
  @media (max-width: 400px) {
    .ctas {
      gap: 10px;
    }
    .store {
      padding: 0 16px 0 14px;
    }
  }
</style>
