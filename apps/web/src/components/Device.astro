---
// The phone itself: titanium frame, status bar, glass header and composer. Conversations go in
// the default slot and use the classes below (.me, .mate, .card, .stamp, .event, .note, .in).
// Styles are global but scoped under .device so pages can reuse the app look without clashing.
import type { PolygonState } from "@muse-clone/mascot";
import Mascot from "./Mascot";

export type Face = { gradient: [string, string, string]; state?: PolygonState };

interface Props {
  title?: string;
  faces?: Face[];
  /** "stack": faces above the title, like a group. "pill": one face beside it in a glass pill. */
  header?: "stack" | "pill";
  /** "full": the slot owns the whole screen under the status bar (no chat header or composer),
   * and the phone is reachable by keyboard and screen readers, for screens people can use. */
  screen?: "chat" | "full";
  /** Screen colour behind the status bar, for full screens with their own background. */
  background?: string;
}

const { title = "", faces = [], header = "stack", screen = "chat", background } = Astro.props;
const full = screen === "full";
---

<div class:list={["device", { full }]} aria-hidden={full ? undefined : "true"} style={background ? `--screen-bg: ${background}` : undefined}>
  <span class="btn action"></span>
  <span class="btn vol-up"></span>
  <span class="btn vol-down"></span>
  <span class="btn power"></span>

  <div class="bezel">
    <div class="screen">
      <div class="status">
        <span class="time">9:41</span>
        <span class="island"></span>
        <span class="icons">
          <svg width="18" height="12" viewBox="0 0 18 12"><rect x="0" y="8" width="3" height="4" rx="1" /><rect x="5" y="5.5" width="3" height="6.5" rx="1" /><rect x="10" y="3" width="3" height="9" rx="1" /><rect x="15" y="0" width="3" height="12" rx="1" /></svg>
          <svg width="16" height="12" viewBox="0 0 16 12"><path d="M8 2.6c2.2 0 4.2.8 5.7 2.2l1.2-1.2A9.7 9.7 0 0 0 8 .9 9.7 9.7 0 0 0 1.1 3.6l1.2 1.2A8 8 0 0 1 8 2.6zm0 3.4c1.3 0 2.5.5 3.3 1.3l1.2-1.2A6.3 6.3 0 0 0 8 4.3a6.3 6.3 0 0 0-4.5 1.8l1.2 1.2C5.5 6.5 6.7 6 8 6zm0 3.4c.5 0 .9.2 1.2.5L8 11.1 6.8 9.9c.3-.3.7-.5 1.2-.5z" /></svg>
          <span class="battery"><span></span></span>
        </span>
      </div>

      {full ? (
        <div class="fill">
          <slot />
        </div>
      ) : (
      <>
      <header class="bar">
        <span class="glass round">
          <svg width="10" height="16" viewBox="0 0 10 16"><path d="M8.5 1.5 2 8l6.5 6.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </span>
        {
          header === "stack" ? (
            <div class="title">
              <div class="stack">{faces.map((face) => <Mascot client:visible size={26} gradient={face.gradient} state={face.state} />)}</div>
              <div class="name">{title} <span class="chev">›</span></div>
            </div>
          ) : (
            <div class="glass pill">
              <Mascot client:visible size={24} gradient={faces[0]!.gradient} state={faces[0]!.state} />
              <span>{title}</span>
            </div>
          )
        }
        <span class="glass round call">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
        </span>
      </header>

      <div class="thread">
        <slot />
      </div>

      <div class="composer">
        <span class="glass round plus">
          <svg width="14" height="14" viewBox="0 0 14 14"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        </span>
        <span class="glass field">Ask your mates…</span>
        <span class="send">
          <svg width="14" height="16" viewBox="0 0 14 16"><path d="M7 14V2M1.5 7.5 7 2l5.5 5.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </span>
      </div>
      </>
      )}
      <div class="home"></div>
    </div>
  </div>
</div>

<style is:global>

  .device {
    /* The screen speaks the page palette, so phone and page read as one. */
    --ink: var(--text);
    --sub: var(--muted);
    --mute: var(--muted);
    --raise: var(--soft);
    position: relative;
    width: 364px;
    height: 760px;
    padding: 4px;
    border-radius: 64px;
    /* Titanium band: light catches the top-left edge. */
    background: linear-gradient(145deg, #d6d6d8 0%, #8a8a8f 18%, #3d3d40 50%, #8a8a8f 82%, #c9c9cc 100%);
    box-shadow:
      0 50px 100px -30px rgba(15, 23, 42, 0.45),
      0 30px 60px -40px rgba(15, 23, 42, 0.5);
    font-family: var(--font);
    color: var(--ink);
    text-align: left;
  }
  .device .btn {
    position: absolute;
    width: 4px;
    border-radius: 2px;
    background: linear-gradient(90deg, #6b6b70, #b8b8bc);
  }
  .action { left: -3px; top: 128px; height: 30px; }
  .vol-up { left: -3px; top: 182px; height: 56px; }
  .vol-down { left: -3px; top: 250px; height: 56px; }
  .power { right: -3px; top: 210px; height: 86px; background: linear-gradient(270deg, #6b6b70, #b8b8bc); }

  .device .bezel {
    height: 100%;
    padding: 10px;
    border-radius: 60px;
    background: #050505;
  }
  .device .screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 50px;
    background: var(--screen-bg, var(--bg));
    display: flex;
    flex-direction: column;
  }
  /* A full screen: the slot takes everything between the status bar and the home bar. */
  .device .fill {
    position: relative;
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding-bottom: 22px;
  }

  .device .status {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
    padding: 6px 26px 0 34px;
    flex: none;
  }
  .device .time {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .device .island {
    position: absolute;
    top: 11px;
    left: 50%;
    width: 112px;
    height: 32px;
    border-radius: 20px;
    background: #000;
    transform: translateX(-50%);
  }
  .device .icons {
    display: flex;
    align-items: center;
    gap: 5px;
    fill: var(--ink);
  }
  .device .battery {
    position: relative;
    width: 25px;
    height: 12px;
    padding: 1.5px;
    border: 1px solid rgba(15, 23, 42, 0.35);
    border-radius: 4px;
  }
  .device .battery span {
    display: block;
    width: 80%;
    height: 100%;
    border-radius: 2px;
    background: var(--ink);
  }
  .device .battery::after {
    content: "";
    position: absolute;
    right: -4px;
    top: 3px;
    width: 2px;
    height: 4px;
    border-radius: 0 2px 2px 0;
    background: rgba(15, 23, 42, 0.4);
  }

  /* Liquid Glass stand-in: frosted fill, hairline rim, soft lift. */
  .device .glass {
    background: rgba(255, 255, 255, 0.72);
    -webkit-backdrop-filter: blur(18px) saturate(180%);
    backdrop-filter: blur(18px) saturate(180%);
    box-shadow:
      inset 0 0 0 0.5px rgba(255, 255, 255, 0.9),
      0 0 0 0.5px rgba(15, 23, 42, 0.08),
      0 6px 16px -6px rgba(15, 23, 42, 0.18);
  }
  .device .round {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    flex: none;
    color: var(--ink);
  }

  .device .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 14px 10px;
    flex: none;
  }
  .device .title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }
  .device .stack {
    display: flex;
  }
  .device .stack > * + * {
    margin-left: -10px;
  }
  .device .name {
    font-size: 13px;
    font-weight: 600;
  }
  .device .chev {
    color: var(--mute);
  }

  .device .thread {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 4px 16px 0;
    overflow: hidden;
    font-size: 14px;
    line-height: 1.42;
  }
  .device .stamp {
    align-self: center;
    color: var(--mute);
    font-size: 11px;
    font-weight: 500;
  }
  .device .me {
    align-self: flex-end;
    max-width: 78%;
    padding: 9px 14px;
    border-radius: 20px;
    border-bottom-right-radius: 6px;
    background: var(--ink);
    color: var(--bg);
  }
  .device .mate p {
    margin: 4px 0 0;
    color: var(--ink);
  }
  .device .who {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--sub);
    font-size: 12px;
    font-weight: 600;
  }

  .device .card {
    padding: 12px 13px;
    border-radius: 20px;
    border: 1px solid var(--line);
    background: var(--panel);
  }
  .device .label {
    margin-bottom: 8px;
    color: var(--mute);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .device .row {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .device .row + .row {
    margin-top: 10px;
  }
  .device .grow {
    flex: 1;
    min-width: 0;
  }
  .device .row-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 13.5px;
  }
  .device .task {
    color: var(--sub);
    font-size: 12.5px;
  }
  .device .chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
  }
  .device .chip.working {
    background: var(--soft);
    color: var(--text);
  }
  .device .chip.done {
    background: var(--success-soft);
    color: var(--success);
  }

  .device .repo {
    font-weight: 600;
    font-size: 14px;
  }
  .device .branch {
    color: var(--mute);
    font-size: 12px;
  }
  .device .feed {
    margin-top: 10px;
    padding: 9px 10px;
    border-radius: 12px;
    background: var(--raise);
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 11px;
    line-height: 1.7;
  }
  .device .feed .old {
    color: var(--mute);
  }
  .device .feed .now {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--ink);
  }

  .device .note {
    align-self: flex-start;
    display: inline-flex;
    gap: 6px;
    padding: 7px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--sub);
    font-size: 12.5px;
  }
  .device .note b {
    color: var(--ink);
    font-weight: 600;
  }

  .device .composer {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 30px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .device .field {
    flex: 1;
    height: 44px;
    display: flex;
    align-items: center;
    padding: 0 16px;
    border-radius: 22px;
    color: var(--mute);
    font-size: 14px;
  }
  .device .plus {
    width: 44px;
    height: 44px;
  }
  .device .send {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg);
    flex: none;
  }
  .device .home {
    position: absolute;
    bottom: 9px;
    left: 50%;
    width: 128px;
    height: 5px;
    border-radius: 3px;
    background: var(--ink);
    transform: translateX(-50%);
  }

  /* Messages arrive in order, then the work keeps ticking. */
  .device .in {
    opacity: 0;
    animation: arrive 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) var(--d) forwards;
  }
  .device .pulse {
    display: inline-flex;
    gap: 2.5px;
  }
  .device .pulse i {
    width: 3.5px;
    height: 3.5px;
    border-radius: 50%;
    background: currentColor;
    animation: blink 1.2s infinite ease-in-out;
  }
  .device .pulse i:nth-child(2) {
    animation-delay: 0.15s;
  }
  .device .pulse i:nth-child(3) {
    animation-delay: 0.3s;
  }
  @media (prefers-reduced-motion: reduce) {
    .device .in {
      opacity: 1;
    }
  }
  .device .pill {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 14px 0 8px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 600;
  }
  .device .event {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--mute);
    font-size: 12.5px;
  }
  .device .event b {
    color: var(--ink);
    font-weight: 500;
  }
  .device .them {
    align-self: flex-start;
    max-width: 86%;
    padding: 10px 14px;
    border-radius: 20px;
    border-bottom-left-radius: 6px;
    background: var(--raise);
  }
  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes blink {
    0%,
    80%,
    100% {
      opacity: 0.25;
    }
    40% {
      opacity: 1;
    }
  }
</style>
