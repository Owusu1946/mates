---
// A still of the app mid-mission, built from the same parts the app uses. Pure HTML and CSS.
import StaticMascot from "./StaticMascot.astro";

const cooper: [string, string, string] = ["#e5c59e", "#d27e41", "#9A3412"];
const nova: [string, string, string] = ["#c7dcff", "#5b8def", "#1e3a8a"];
const ivy: [string, string, string] = ["#d9f99d", "#4ade80", "#166534"];
---

<div class="device" aria-hidden="true">
  <span class="btn action"></span>
  <span class="btn vol-up"></span>
  <span class="btn vol-down"></span>
  <span class="btn power"></span>

  <div class="bezel">
    <div class="screen">
      <div class="status">
        <span class="time">9:41</span>
        <span class="island"></span>
        <span class="icons">
          <svg width="18" height="12" viewBox="0 0 18 12"><rect x="0" y="8" width="3" height="4" rx="1" /><rect x="5" y="5.5" width="3" height="6.5" rx="1" /><rect x="10" y="3" width="3" height="9" rx="1" /><rect x="15" y="0" width="3" height="12" rx="1" /></svg>
          <svg width="16" height="12" viewBox="0 0 16 12"><path d="M8 2.6c2.2 0 4.2.8 5.7 2.2l1.2-1.2A9.7 9.7 0 0 0 8 .9 9.7 9.7 0 0 0 1.1 3.6l1.2 1.2A8 8 0 0 1 8 2.6zm0 3.4c1.3 0 2.5.5 3.3 1.3l1.2-1.2A6.3 6.3 0 0 0 8 4.3a6.3 6.3 0 0 0-4.5 1.8l1.2 1.2C5.5 6.5 6.7 6 8 6zm0 3.4c.5 0 .9.2 1.2.5L8 11.1 6.8 9.9c.3-.3.7-.5 1.2-.5z" /></svg>
          <span class="battery"><span></span></span>
        </span>
      </div>

      <header class="bar">
        <span class="glass round">
          <svg width="10" height="16" viewBox="0 0 10 16"><path d="M8.5 1.5 2 8l6.5 6.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </span>
        <div class="title">
          <div class="stack">
            <StaticMascot size={26} gradient={cooper} expression={2} />
            <StaticMascot size={26} gradient={nova} />
            <StaticMascot size={26} gradient={ivy} expression={8} />
          </div>
          <div class="name">Launch week <span class="chev">›</span></div>
        </div>
        <span class="glass round dots"><i></i><i></i><i></i></span>
      </header>

      <div class="thread">
        <div class="stamp">Today 9:38</div>

        <div class="me in" style="--d: 0.1s">Ship dark mode in the app and get the release notes ready for Friday.</div>

        <div class="mate in" style="--d: 0.5s">
          <div class="who"><StaticMascot size={20} gradient={cooper} expression={2} /> Cooper</div>
          <p>On it. Nova takes the code, Ivy writes the notes. I’ll keep you posted.</p>
        </div>

        <div class="card in" style="--d: 0.9s">
          <div class="label">Handing off</div>
          <div class="row">
            <StaticMascot size={28} gradient={nova} />
            <div class="grow">
              <div class="row-top"><b>Nova</b><span class="chip working">Working<span class="pulse"><i></i><i></i><i></i></span></span></div>
              <div class="task">Build dark mode across settings and chat</div>
            </div>
          </div>
          <div class="row">
            <StaticMascot size={28} gradient={ivy} expression={8} />
            <div class="grow">
              <div class="row-top"><b>Ivy</b><span class="chip done">✓ Done</span></div>
              <div class="task">Draft the v2.4 release notes</div>
            </div>
          </div>
        </div>

        <div class="card in" style="--d: 1.3s">
          <div class="label">Mates’ computer</div>
          <div class="repo">acme/app</div>
          <div class="branch">mates/dark-mode-3f9a1c</div>
          <div class="feed">
            <div class="old">Editing src/theme/tokens.ts</div>
            <div class="old">pnpm typecheck passed</div>
            <div class="now">Running pnpm test <span class="pulse"><i></i><i></i><i></i></span></div>
          </div>
        </div>

        <div class="note in" style="--d: 1.7s"><span>📝</span> Ivy wrote <b>Release notes v2.4</b></div>
      </div>

      <div class="composer">
        <span class="glass round plus">
          <svg width="14" height="14" viewBox="0 0 14 14"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        </span>
        <span class="glass field">Ask your mates…</span>
        <span class="send">
          <svg width="14" height="16" viewBox="0 0 14 16"><path d="M7 14V2M1.5 7.5 7 2l5.5 5.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </span>
      </div>
      <div class="home"></div>
    </div>
  </div>
</div>

<style>
  .device {
    --ink: #0f172a;
    --sub: #475569;
    --mute: #94a3b8;
    --line: #e2e8f0;
    --raise: #f1f5f9;
    position: relative;
    width: 364px;
    height: 760px;
    padding: 4px;
    border-radius: 64px;
    /* Titanium band: light catches the top-left edge. */
    background: linear-gradient(145deg, #d6d6d8 0%, #8a8a8f 18%, #3d3d40 50%, #8a8a8f 82%, #c9c9cc 100%);
    box-shadow:
      0 50px 100px -30px rgba(15, 23, 42, 0.45),
      0 30px 60px -40px rgba(15, 23, 42, 0.5);
    font-family: var(--font);
    color: var(--ink);
    text-align: left;
  }
  .btn {
    position: absolute;
    width: 4px;
    border-radius: 2px;
    background: linear-gradient(90deg, #6b6b70, #b8b8bc);
  }
  .action { left: -3px; top: 128px; height: 30px; }
  .vol-up { left: -3px; top: 182px; height: 56px; }
  .vol-down { left: -3px; top: 250px; height: 56px; }
  .power { right: -3px; top: 210px; height: 86px; background: linear-gradient(270deg, #6b6b70, #b8b8bc); }

  .bezel {
    height: 100%;
    padding: 10px;
    border-radius: 60px;
    background: #050505;
  }
  .screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 50px;
    background: #fff;
    display: flex;
    flex-direction: column;
  }

  .status {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
    padding: 6px 26px 0 34px;
    flex: none;
  }
  .time {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .island {
    position: absolute;
    top: 11px;
    left: 50%;
    width: 112px;
    height: 32px;
    border-radius: 20px;
    background: #000;
    transform: translateX(-50%);
  }
  .icons {
    display: flex;
    align-items: center;
    gap: 5px;
    fill: var(--ink);
  }
  .battery {
    position: relative;
    width: 25px;
    height: 12px;
    padding: 1.5px;
    border: 1px solid rgba(15, 23, 42, 0.35);
    border-radius: 4px;
  }
  .battery span {
    display: block;
    width: 80%;
    height: 100%;
    border-radius: 2px;
    background: var(--ink);
  }
  .battery::after {
    content: "";
    position: absolute;
    right: -4px;
    top: 3px;
    width: 2px;
    height: 4px;
    border-radius: 0 2px 2px 0;
    background: rgba(15, 23, 42, 0.4);
  }

  /* Liquid Glass stand-in: frosted fill, hairline rim, soft lift. */
  .glass {
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(18px) saturate(180%);
    box-shadow:
      inset 0 0 0 0.5px rgba(255, 255, 255, 0.9),
      0 0 0 0.5px rgba(15, 23, 42, 0.08),
      0 6px 16px -6px rgba(15, 23, 42, 0.18);
  }
  .round {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    flex: none;
    color: var(--ink);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 14px 10px;
    flex: none;
  }
  .title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }
  .stack {
    display: flex;
  }
  .stack :global(svg + svg) {
    margin-left: -10px;
  }
  .name {
    font-size: 13px;
    font-weight: 600;
  }
  .chev {
    color: var(--mute);
  }
  .dots {
    gap: 3px;
    grid-auto-flow: column;
  }
  .dots i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--ink);
  }

  .thread {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 4px 16px 0;
    overflow: hidden;
    font-size: 14px;
    line-height: 1.42;
  }
  .stamp {
    align-self: center;
    color: var(--mute);
    font-size: 11px;
    font-weight: 500;
  }
  .me {
    align-self: flex-end;
    max-width: 78%;
    padding: 9px 14px;
    border-radius: 20px;
    border-bottom-right-radius: 6px;
    background: var(--ink);
    color: #fff;
  }
  .mate p {
    margin: 4px 0 0;
    color: var(--ink);
  }
  .who {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--sub);
    font-size: 12px;
    font-weight: 600;
  }

  .card {
    padding: 12px 13px;
    border-radius: 20px;
    border: 1px solid var(--line);
    background: #f8fafc;
  }
  .label {
    margin-bottom: 8px;
    color: var(--mute);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .row {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .row + .row {
    margin-top: 10px;
  }
  .grow {
    flex: 1;
    min-width: 0;
  }
  .row-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 13.5px;
  }
  .task {
    color: var(--sub);
    font-size: 12.5px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
  }
  .chip.working {
    background: #eef2ff;
    color: #4f46e5;
  }
  .chip.done {
    background: #ecfdf3;
    color: #30a46c;
  }

  .repo {
    font-weight: 600;
    font-size: 14px;
  }
  .branch {
    color: var(--mute);
    font-size: 12px;
  }
  .feed {
    margin-top: 10px;
    padding: 9px 10px;
    border-radius: 12px;
    background: var(--raise);
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 11px;
    line-height: 1.7;
  }
  .feed .old {
    color: var(--mute);
  }
  .feed .now {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--ink);
  }

  .note {
    align-self: flex-start;
    display: inline-flex;
    gap: 6px;
    padding: 7px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--sub);
    font-size: 12.5px;
  }
  .note b {
    color: var(--ink);
    font-weight: 600;
  }

  .composer {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 30px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .field {
    flex: 1;
    height: 44px;
    display: flex;
    align-items: center;
    padding: 0 16px;
    border-radius: 22px;
    color: var(--mute);
    font-size: 14px;
  }
  .plus {
    width: 44px;
    height: 44px;
  }
  .send {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    flex: none;
  }
  .home {
    position: absolute;
    bottom: 9px;
    left: 50%;
    width: 128px;
    height: 5px;
    border-radius: 3px;
    background: var(--ink);
    transform: translateX(-50%);
  }

  /* Messages arrive in order, then the work keeps ticking. */
  .in {
    opacity: 0;
    animation: arrive 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) var(--d) forwards;
  }
  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .pulse {
    display: inline-flex;
    gap: 2.5px;
  }
  .pulse i {
    width: 3.5px;
    height: 3.5px;
    border-radius: 50%;
    background: currentColor;
    animation: blink 1.2s infinite ease-in-out;
  }
  .pulse i:nth-child(2) {
    animation-delay: 0.15s;
  }
  .pulse i:nth-child(3) {
    animation-delay: 0.3s;
  }
  @keyframes blink {
    0%,
    80%,
    100% {
      opacity: 0.25;
    }
    40% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .in {
      opacity: 1;
    }
  }
</style>
