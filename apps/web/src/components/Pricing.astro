---
// Monthly USD defaults in apps/api/src/usage/plans.ts. Mobile displays store-localized offers.
const plans = [
  { name: "Starter", price: 8, benefit: "Up to 5 mates and 3 routines.", limits: "1 active mission. Standard weekly usage." },
  { name: "Plus", price: 15, benefit: "Watch for changes across the week.", limits: "10 mates, 2 active missions and 5 watches. Twice Starter’s weekly usage." },
  { name: "Pro", price: 40, benefit: "Use a computer and open pull requests.", limits: "20 mates, unlimited saved routines and 15 watches. Six times Starter’s weekly usage." },
  { name: "Max", price: 80, benefit: "Work through longer sessions.", limits: "10 active missions and 40 watches. Twelve times Starter’s weekly usage, with no five-hour cap." },
];
---
<section id="pricing" class="pricing">
  <h2>Pricing</h2>
  <p>Monthly prices in USD. See local prices and yearly options in the app.</p>
  <div class="plans">{plans.map(plan => <article><h3>{plan.name}</h3><strong>${plan.price}</strong><span> / month</span><p>{plan.benefit}</p></article>)}</div>
  <details><summary>Compare plan limits</summary><dl>{plans.map(plan => <div><dt>{plan.name}</dt><dd>{plan.limits}</dd></div>)}</dl></details>
</section>
<style>
  .pricing { width: min(1120px, calc(100% - 40px)); margin: clamp(80px, 10vw, 144px) auto 0; }
  h2 { margin: 0; font-size: clamp(36px, 4vw, 56px); line-height: 1.08; letter-spacing: -0.045em; }
  p, span, dd { color: var(--muted); line-height: 1.55; }
  .plans, dl { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 24px; }
  .plans { margin: 32px 0 12px; }
  article { border-top: 1px solid var(--line); padding-top: 20px; }
  h3, dt { font-size: 16px; font-weight: 600; }
  h3 { margin: 0 0 16px; }
  strong { font: 500 clamp(32px, 4vw, 48px)/1 var(--display); letter-spacing: -0.05em; font-variant-numeric: tabular-nums; }
  details { border-block: 1px solid var(--line); }
  summary { cursor: pointer; padding: 16px 0; }
  dd { margin: 6px 0 16px; }
  @media(max-width: 780px) { .plans, dl { grid-template-columns: repeat(2, minmax(0,1fr)); gap: 16px; } }
</style>
