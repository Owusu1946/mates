---
// The hero's three phones: the mission up front, two more mates at work behind it. The back pair
// fan out and sit back in depth so the eye lands on the middle one first. They drop out on
// narrow screens, where there is no room beside the main phone.
import { mate } from "../palette";
import Device from "./Device.astro";
import Phone from "./Phone.astro";

const sky = mate("rose");
const sun = mate("sunset");
---

<div class="trio">
  <div class="back left">
    <Device title="Daily Brief" header="pill" faces={[{ gradient: sky, state: "happy" }]}>
      <div class="stamp">Illustrative · 7:00 AM</div>
      <div class="them">3 meetings today. First at 10:00 — Airport City.</div>
      <div class="them">Leave by 9:12 if you’re driving. Rain after 2pm.</div>
      <div class="event">Created routine <b>Morning brief · weekdays</b></div>
      <div class="me">move the 10am — it clashes with stand-up</div>
      <div class="them">I can propose 1:30. You approve before I update the invite.</div>
    </Device>
  </div>

  <div class="back right">
    <Device title="Commute" header="pill" faces={[{ gradient: sun, state: "excited" }]}>
      <div class="stamp">Illustrative · Accra</div>
      <div class="me">Circle to the airport. Under ₵60, leaving in 15.</div>
      <div class="them">Yango Comfort <b>₵52</b> · ~7 min pickup.</div>
      <div class="them">Trotro via Kaneshie <b>₵5</b> + short ride <b>₵18</b> · ~35 min.</div>
      <div class="event">Ride options <b>ready to review</b></div>
      <div class="them">Nothing books until you tap go.</div>
    </Device>
  </div>

  <div class="front">
    <Phone />
  </div>
</div>

<style>
  .trio {
    position: relative;
    display: flex;
    justify-content: center;
    width: 100%;
  }
  .front {
    position: relative;
    z-index: 2;
  }
  .back {
    position: absolute;
    top: 70px;
    z-index: 1;
    opacity: 0.92;
    filter: saturate(0.9);
  }
  .left {
    right: 50%;
    transform: translateX(-120px) rotate(-7deg) scale(0.84);
    transform-origin: top right;
  }
  .right {
    left: 50%;
    transform: translateX(120px) rotate(7deg) scale(0.84);
    transform-origin: top left;
  }
  /* A soft veil pushes the back pair into the distance. */
  .back::after {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    border-radius: 64px;
    background: linear-gradient(rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.35));
    pointer-events: none;
  }

  @media (max-width: 1100px) {
    .left {
      transform: translateX(-60px) rotate(-7deg) scale(0.78);
    }
    .right {
      transform: translateX(60px) rotate(7deg) scale(0.78);
    }
  }
  @media (max-width: 860px) {
    .back {
      display: none;
    }
  }
</style>
