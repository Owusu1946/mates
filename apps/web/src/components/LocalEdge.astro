---
// Product slices that are easy to miss from generic “AI assistant” landings: calendar-aware
// mornings, local ride quotes, and meeting follow-through. Copy is illustrative, not a live feed.
const tiles = [
  {
    eyebrow: "Morning brief",
    title: "Leave when it actually makes sense",
    body: "Your routine pulls today’s calendar, weather, and what still needs you — then suggests when to head out.",
    lines: [
      { who: "brief", text: "3 meetings today. First at 10:00 in Airport City." },
      { who: "brief", text: "Leave by 9:12 if you’re driving. Rain after 2pm." },
      { who: "you", text: "Move the 10am if it clashes with stand-up." },
      { who: "brief", text: "Stand-up overlaps 20 min. I can propose 1:30 — you approve before I send." },
    ],
  },
  {
    eyebrow: "Rides & transit",
    title: "Quotes in GHS, not guesswork",
    body: "Compare on-demand rides with trotro-style legs when it’s useful. You pick; nothing books until you say so.",
    lines: [
      { who: "you", text: "Circle to Airport. Under ₵60, leaving in 15." },
      { who: "brief", text: "Yango Comfort ₵52 · ~7 min pickup." },
      { who: "brief", text: "Trotro via Kaneshie ₵5 + short ride ₵18 · ~35 min." },
    ],
  },
  {
    eyebrow: "Meetings",
    title: "Prep before, notes after",
    body: "Briefing cards before calls with people. A mate can join Meet to listen, answer when asked, and send notes when you hang up.",
    lines: [
      { who: "brief", text: "Investor sync at 3pm — open items from last week’s deck." },
      { who: "brief", text: "Two attendees haven’t accepted yet." },
      { who: "you", text: "Join and take notes." },
      { who: "brief", text: "I’ll post decisions and action items when the call ends." },
    ],
  },
];
---
<section class="local" id="local" aria-labelledby="local-title">
  <div class="shell">
    <div class="heading">
      <p class="eyebrow">Built for real days</p>
      <h2 id="local-title">Calendar, commute, and calls — not just chat.</h2>
      <p class="lede">
        Mates is designed around how work actually runs: mornings with meetings, getting across town, and leaving a call with clear next steps.
      </p>
    </div>
    <div class="grid">
      {tiles.map((tile) => (
        <article class="tile">
          <header>
            <span class="tile-eyebrow">{tile.eyebrow}</span>
            <h3>{tile.title}</h3>
            <p>{tile.body}</p>
          </header>
          <div class="mini-chat" aria-hidden="true">
            {tile.lines.map((line) => (
              <div class={line.who === "you" ? "bubble you" : "bubble them"}>{line.text}</div>
            ))}
          </div>
        </article>
      ))}
    </div>
    <p class="fine">Illustrative scenarios · Availability depends on your connections, region, and plan.</p>
  </div>
</section>
<style>
  .local {
    margin-top: 96px;
    padding: 72px 0 80px;
    background:
      radial-gradient(70% 80% at 12% 0%, color-mix(in srgb, var(--accent) 18%, transparent), transparent),
      radial-gradient(60% 70% at 88% 100%, color-mix(in srgb, var(--accent-deep) 12%, transparent), transparent),
      var(--panel);
    border-block: 1px solid var(--line);
  }
  .shell {
    width: min(1240px, calc(100% - 32px));
    margin: 0 auto;
  }
  .heading {
    max-width: 52ch;
    margin-bottom: 48px;
  }
  .eyebrow {
    margin: 0 0 14px;
    color: var(--accent-deep);
    font-size: 13px;
    font-weight: 600;
  }
  h2 {
    margin: 0;
    font-size: clamp(30px, 3.8vw, 48px);
    line-height: 1.08;
    letter-spacing: -0.04em;
    font-weight: 600;
  }
  .lede {
    margin: 18px 0 0;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.6;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 28px 24px 24px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 20px;
    box-shadow: 0 24px 48px rgba(15, 23, 42, 0.04);
  }
  .tile-eyebrow {
    display: inline-block;
    margin-bottom: 10px;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-deep);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  h3 {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .tile header p {
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.55;
  }
  .mini-chat {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: auto;
    padding-top: 8px;
  }
  .bubble {
    max-width: 95%;
    padding: 10px 12px;
    border-radius: 14px;
    font-size: 12.5px;
    line-height: 1.45;
  }
  .bubble.them {
    align-self: flex-start;
    background: var(--soft);
    color: var(--text);
  }
  .bubble.you {
    align-self: flex-end;
    background: var(--text);
    color: var(--bg);
  }
  .fine {
    margin: 28px 0 0;
    color: var(--muted);
    font-size: 13px;
  }
  @media (max-width: 960px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .local {
      margin-top: 64px;
      padding: 48px 0 56px;
    }
  }
</style>