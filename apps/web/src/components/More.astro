---
// "And the everyday stuff": the smaller jobs coming next, as a row of quiet tiles, each a line
// icon, a name and one sentence. The big ones (calls, Meet, decks) have their own sections.
const items = [
  {
    title: "Meeting prep",
    body: "A brief before every meeting: who’s coming, what you last said, what to ask.",
    icon: "M8 3v3M16 3v3M4 8h16M5 5h14v15H5zM9 13h6M9 16h4",
  },
  {
    title: "Docs and spreadsheets",
    body: "Budgets, invoices, CVs and reports, as files you can send.",
    icon: "M6 3h8l4 4v14H6zM14 3v4h4M9 12h6M9 15h6M9 18h4",
  },
  {
    title: "Receipts",
    body: "Snap a receipt and it lands in your expenses sheet, sorted.",
    icon: "M6 3h12v18l-3-2-3 2-3-2-3 2zM9 8h6M9 12h6M9 16h3",
  },
  {
    title: "Price watch",
    body: "Say what to watch, and your mate pings you when it drops.",
    icon: "M3 12l7-7h7v7l-7 7zM14 8.5h.01M7 17l-3 3",
  },
];
---

<section class="more" id="more">
  <div class="head">
    <div class="eyebrow">Also coming <span class="soon">Coming soon</span></div>
    <h2>And the everyday stuff.</h2>
  </div>
  <div class="tiles">
    {
      items.map((item) => (
        <article class="tile">
          <span class="icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d={item.icon} />
            </svg>
          </span>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .more {
    width: min(1240px, calc(100% - 32px));
    margin: 120px auto 0;
  }
  .head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .soon {
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-deep);
    font-size: 11.5px;
    letter-spacing: 0.02em;
    text-transform: none;
  }
  h2 {
    margin: 14px 0 0;
    font-size: clamp(26px, 3vw, 40px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-top: 40px;
  }
  .tile {
    padding: 24px;
    border-radius: 24px;
    background: var(--panel);
    transition: transform 0.2s ease;
  }
  .tile:hover {
    transform: translateY(-3px);
  }
  .icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: var(--bg);
    color: var(--accent-deep);
    box-shadow: 0 0 0 1px var(--line);
  }
  h3 {
    margin: 18px 0 0;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  p {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.5;
  }

  @media (max-width: 1024px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .more {
      margin-top: 88px;
    }
    .tiles {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .tile {
      display: grid;
      grid-template-columns: 44px 1fr;
      column-gap: 14px;
      padding: 18px;
    }
    .icon {
      grid-row: span 2;
    }
    h3 {
      margin: 2px 0 0;
    }
  }
</style>
