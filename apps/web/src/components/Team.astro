---
import Mascot from "./Mascot";
import { mate } from "../palette";
---
<article class="chat" id="team" aria-label="Example team conversation">
  <header><strong>Meetup follow-up</strong><small>Interactive example</small></header>
  <p class="question">Help me follow up after the Accra meetup.</p>
  <div class="reply">
    <Mascot size={38} gradient={mate("amber")} />
    <div><b>Cooper</b> <small>Lead mate</small><p>Ivy, could you draft a thank-you for the speakers?</p></div>
  </div>
  <details>
    <summary><Mascot size={38} gradient={mate("green")} shape="circle" /><span><b>Ivy</b> <small>Writer</small><span class="action">Review draft</span></span><span class="arrow" aria-hidden="true">↓</span></summary>
    <div class="draft"><b>Thanks for joining us in Accra</b><p>Thanks for sharing your work at the meetup. Could you send over your slides? I’d love to pass them on to everyone who came.</p></div>
  </details>
</article>
<style>
  .chat { min-width: 0; padding: clamp(20px, 3vw, 40px); background: #fffefa; border: 1px solid var(--line); border-radius: 20px; box-shadow: 0 18px 60px -45px #3c352b70; }
  header, summary, .reply { display: flex; align-items: center; gap: 12px; }
  header { justify-content: space-between; flex-wrap: wrap; border-bottom: 1px solid var(--line); padding-bottom: 16px; }
  small { color: var(--muted); font-size: 13px; }
  p { margin: 6px 0 0; line-height: 1.5; }
  .question { width: fit-content; max-width: 85%; margin: 24px 0 24px auto; padding: 10px 16px; background: var(--soft); border-radius: 16px 16px 4px 16px; }
  .reply { align-items: flex-start; }
  details { margin-top: 20px; border-top: 1px solid var(--line); }
  summary { cursor: pointer; list-style: none; padding-top: 16px; }
  summary::-webkit-details-marker { display: none; }
  .action { display: block; margin-top: 4px; text-decoration: underline; text-underline-offset: 3px; }
  .arrow { margin-left: auto; transition: transform 180ms ease; }
  details[open] .arrow { transform: rotate(180deg); }
  .draft { margin-top: 16px; padding: 16px; background: var(--soft); border-radius: 8px; animation: arrive 180ms ease-out; }
  @keyframes arrive { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
</style>
