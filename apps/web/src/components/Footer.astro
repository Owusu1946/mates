---
import Logo from "./Logo.astro";

const links = [
  { label: "FAQ", href: "/#faq" },
  { label: "Privacy", href: "/privacy" },
  { label: "Terms", href: "/terms" },
];
---
<footer class="footer">
  <a href="/" class="brand" aria-label="Mates home">
    <Logo size={28} />
    <span>mates</span>
  </a>
  <nav aria-label="Footer">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
  <span class="credit">Built by Mates Agent</span>
  <p class="meta">© {new Date().getFullYear()} Orin</p>
</footer>
<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px;
    width: min(1120px, calc(100% - 40px));
    margin: 96px auto 0;
    padding: 28px 0 48px;
    border-top: 1px solid var(--line);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-family: var(--display);
    font-size: 16px;
    font-weight: 560;
    letter-spacing: -0.03em;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin-left: auto;
    font-size: 14px;
  }
  nav a {
    color: var(--muted);
    transition: color 0.2s ease;
  }
  nav a:hover {
    color: var(--text);
  }
  .credit { order: 4; flex-basis: 100%; text-align: center; margin-top: 8px; font-size: 12px; color: var(--muted); }
  .meta {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
  }
  @media (max-width: 960px) {
    .footer {
      flex-wrap: wrap;
      gap: 16px;
    }
    nav {
      margin-left: 0;
      width: 100%;
      order: 3;
    }
  }
</style>
