---
// FAQs: native <details>, so it works without script and with the keyboard. Sharing a `name`
// makes them an exclusive group: opening one closes the rest.
const faqs = [
  {
    q: "How is this different from a chatbot?",
    a: "You give mates roles and put them on a job together. They hand work off, use the apps you connect, and keep going after you close the app.",
  },
  {
    q: "Can I try Mates today?",
    a: "Join the waitlist for iPhone and Android. We’ll email you when Mates launches.",
  },
  {
    q: "Can a mate change my code?",
    a: "Pro and Max get the mates’ computer. Changes come back as a GitHub pull request for you to review.",
  },
  {
    q: "How do I disconnect an app?",
    a: "Open Apps in Mates and choose the connection you want to remove.",
  },
];
---

<section class="faq" id="faq">
  <div class="intro"><h2>A few<br />good questions.</h2><a href="#download" data-waitlist>Join the waitlist <span aria-hidden="true">↗</span></a></div>
  <div class="list">
    {
      faqs.map((item) => (
        <details name="faq">
          <summary>
            {item.q}
            <span class="sign" aria-hidden="true" />
          </summary>
          <p>{item.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 48px;
    width: min(1120px, calc(100% - 40px));
    margin: 140px auto 0;
    padding: 40px 0 0;
    border-top: 1px solid var(--line);
  }
  h2 {
    margin: 0;
    font-size: clamp(38px, 4vw, 56px);
    line-height: 1.05;
    font-weight: 500;
    letter-spacing: -0.04em;
  }
  .intro a { display: inline-flex; gap: 12px; margin-top: 24px; padding-block: 8px; font-size: 14px; }
  .intro a:hover { text-decoration: underline; text-underline-offset: 4px; }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 0;
    font-size: clamp(17px, 1.5vw, 20px);
    font-weight: 500;
    letter-spacing: -0.01em;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 4px;
    border-radius: 4px;
  }
  /* The open question uses a minus. */
  .sign {
    position: relative;
    width: 18px;
    height: 18px;
    flex: none;
    transition: transform 180ms ease;
  }
  .sign::before,
  .sign::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    border-radius: 1px;
    background: var(--text);
  }
  .sign::after {
    transform: rotate(90deg);
    transition: transform 180ms ease;
  }
  details[open] .sign {
    transform: rotate(180deg);
  }
  details[open] .sign::after { transform: rotate(0); }
  details[open] p { animation: answer-in 180ms ease-out; }
  @keyframes answer-in { from { opacity: 0; transform: translateY(-3px); } to { opacity: 1; transform: none; } }
  p {
    max-width: 54ch;
    margin: 0;
    padding: 0 40px 28px 0;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.65;
  }

  @media (max-width: 860px) {
    .faq {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-top: 96px;
      padding: 0 8px;
    }
    p {
      padding-right: 0;
    }
  }
</style>
