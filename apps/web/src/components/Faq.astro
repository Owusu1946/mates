---
// FAQs: native <details>, so it works without script and with the keyboard. Sharing a `name`
// makes them an exclusive group: opening one closes the rest.
const faqs = [
  {
    q: "How is this different from a chatbot?",
    a: "You give mates roles and put them on a job together. They hand work off, use the apps you connect, and keep going after you close the app.",
  },
  {
    q: "Where do I talk to them?",
    a: "iPhone and Android, when we launch. Message one mate or a group. Join the waitlist for the date.",
  },
  {
    q: "What about code?",
    a: "Pro and Max get the mates’ computer. Changes come back as a GitHub pull request for you to review.",
  },
  {
    q: "Who controls access?",
    a: "You. Connect or disconnect apps in Settings. You can delete your account and everything in it.",
  },
];
---

<section class="faq" id="faq">
  <h2>FAQs</h2>
  <div class="list">
    {
      faqs.map((item, index) => (
        <details name="faq" open={index === 0}>
          <summary>
            {item.q}
            <span class="sign" aria-hidden="true" />
          </summary>
          <p>{item.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 48px;
    width: min(1240px, calc(100% - 32px));
    margin: 140px auto 0;
    padding: 0 56px;
  }
  h2 {
    margin: 0;
    font-size: clamp(32px, 3.6vw, 48px);
    font-weight: 600;
    letter-spacing: -0.04em;
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 0;
    font-size: clamp(17px, 1.5vw, 20px);
    font-weight: 500;
    letter-spacing: -0.01em;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 4px;
    border-radius: 4px;
  }
  /* A plus that turns into a cross when open. */
  .sign {
    position: relative;
    width: 18px;
    height: 18px;
    flex: none;
    transition: transform 0.25s ease;
  }
  .sign::before,
  .sign::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    border-radius: 1px;
    background: var(--text);
  }
  .sign::after {
    transform: rotate(90deg);
  }
  details[open] .sign {
    transform: rotate(45deg);
  }
  p {
    max-width: 54ch;
    margin: 0;
    padding: 0 40px 28px 0;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.65;
  }

  @media (max-width: 860px) {
    .faq {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-top: 96px;
      padding: 0 8px;
    }
    p {
      padding-right: 0;
    }
  }
</style>
