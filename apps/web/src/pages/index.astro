---
import Roles from "../components/Roles.astro";
import Platforms from "../components/Platforms.astro";
import Capabilities from "../components/Capabilities.astro";
import Memory from "../components/Memory.astro";
import ImportAssistants from "../components/ImportAssistants.astro";
import Faq from "../components/Faq.astro";
import LocalEdge from "../components/LocalEdge.astro";
import Footer from "../components/Footer.astro";
import Logo from "../components/Logo.astro";
import MobileMenu from "../components/MobileMenu.astro";
import Pricing from "../components/Pricing.astro";
import Waitlist from "../components/Waitlist";
import HeroMascot from "../components/HeroMascot";
import HeroStage from "../components/HeroStage.astro";
import Apps from "../components/Apps.astro";
import BackToTop from "../components/BackToTop";
import Calls from "../components/Calls.astro";
import Meet from "../components/Meet.astro";
import Computer from "../components/Computer.astro";
import Base from "../layouts/Base.astro";

const nav = [
  { label: "How it works", href: "#features" },
  { label: "Pricing", href: "#pricing" },
];
const api = import.meta.env.PUBLIC_API_URL ?? "https://mates-production.up.railway.app";
---

<Base skipToContent>
  <header class="nav">
    <a href="/" class="brand" aria-label="Mates home">
      <Logo size={34} />
      <span>mates</span>
    </a>
    <nav aria-label="Main">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="nav-action"><Waitlist client:load api={api} /></div>
    <MobileMenu items={[...nav, { label: "FAQs", href: "#faq" }]} />
  </header>

  <main id="main-content" tabindex="-1">
    <section class="hero" id="features">
      <div class="hero-copy">
        <h1>Your personal team of <span class="hero-mate">AI mates<span class="headline-mascot" aria-hidden="true"><HeroMascot client:idle size={88} /></span></span>.</h1>
        <p class="lede">Give your lead mate a task. Follow the handoff and review the result in the same chat.</p>
        <div id="download"><Platforms /></div>
      </div>
      <div class="hero-phones"><HeroStage /></div>
    </section>

    <ImportAssistants />

    <Roles />

    <LocalEdge />

    <Calls />

    <Meet />

    <Computer />

    <Apps />

    <Capabilities />

    <Memory />

    <Pricing />

    <Faq />


  </main>

  <Footer />
  <BackToTop client:idle />
  <script>
    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    if (!motion.matches && "IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-in");
          observer.unobserve(entry.target);
        }
      }, { threshold: 0.01, rootMargin: "0px 0px -48px 0px" });
      document.querySelectorAll("main > section:not(.hero)").forEach((section) => {
        section.classList.add("reveal");
        observer.observe(section);
      });
    }
  </script>
</Base>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 28px;
    height: 64px;
    padding: 0 28px;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    -webkit-backdrop-filter: saturate(160%) blur(18px);
    backdrop-filter: saturate(160%) blur(18px);
  }
  .nav-action { justify-self: end; }
  .brand {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-family: var(--display);
    font-size: 17px;
    font-weight: 560;
    letter-spacing: -0.03em;
  }
  nav {
    display: flex;
    gap: 22px;
    font-size: 14px;
  }
  nav a {
    color: var(--muted);
    transition: color 0.2s ease;
  }
  nav a:hover {
    color: var(--text);
  }

  .hero-mate { white-space:nowrap; }
  .headline-mascot { display:inline-flex; width:.9em; height:.9em; margin-left:.12em; vertical-align:-.08em; }
  .headline-mascot :global(span) { width:100% !important; height:100% !important; }
  .headline-mascot :global(svg) { width:100%; height:100%; }
  .hero-copy { text-align:center; margin-inline:auto; }
  .hero-copy :global(.options) { justify-content:center; }
  .hero-copy .lede { margin-inline:auto; }
  .hero-phones { width:100%; height:540px; overflow:hidden; mask-image:linear-gradient(#000 85%,transparent); }
  @media(max-width:860px) { .hero-phones { height:480px; } }
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: clamp(40px, 6vw, 96px);
    width: min(1120px, calc(100% - 48px));
    margin: clamp(56px, 8vw, 112px) auto;
  }
  h1 {
    max-width: 13ch;
    margin: 0;
    font-size: clamp(54px, 6vw, 86px);
    font-weight: 475;
    letter-spacing: -0.064em;
    line-height: 1.01;
    text-wrap: balance;
  }
  .lede {
    max-width: 36ch;
    margin: 24px 0 28px;
    color: var(--muted);
    font-size: clamp(17px, 1.6vw, 20px);
    line-height: 1.5;
  }
  @media (max-width: 860px) {
    nav { display: none; }
    .nav { height: 64px; padding: 0 16px; grid-template-columns: 1fr auto auto; gap: 8px; }
    .hero { grid-template-columns: 1fr; max-width: 540px; gap: 36px; margin-block: 40px; }
  }
</style>
