---
import Mascot from "../components/Mascot";
import FeatureCard from "../components/FeatureCard.astro";
import HeroStage from "../components/HeroStage.astro";
import Roles from "../components/Roles.astro";
import Team from "../components/Team.astro";
import Apps from "../components/Apps.astro";
import Computer from "../components/Computer.astro";
import Base from "../layouts/Base.astro";

const nav = [
  { label: "Features", href: "#features" },
  { label: "Missions", href: "#team" },
  { label: "Computer", href: "#computer" },
  { label: "Pricing", href: "#pricing" },
];
// Store links land here once the listings are live.
const appStore = "#download";
const playStore = "#download";
---

<Base>
  <header class="nav">
    <a href="/" class="brand" aria-label="Mates home">
      <Mascot client:idle size={30} />
      <span>mates</span>
    </a>
    <nav aria-label="Main">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a href="#download" class="pill-button dark nav-cta">Get the app</a>
  </header>

  <main>
    <section class="hero">
      <a href="#computer" class="announce">
        <strong>Mates can ship code now</strong>
        <span class="dot">·</span>
        <span>See how it works</span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>

      <h1>
        Meet
        <span class="inline-mascot"><Mascot client:idle size={96} /></span>
        Your Mate Bots
      </h1>

      <p class="lede">
        AI teammates that live in your pocket. Give them real work and they plan it, hand it off to each other, use your
        apps the way you do, and come back with it finished.
      </p>

      <div class="ctas">
        <a href={appStore} class="pill-button dark">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M16.37 12.6c-.02-2.3 1.88-3.4 1.96-3.46-1.07-1.56-2.73-1.77-3.32-1.8-1.41-.14-2.76.83-3.48.83-.72 0-1.82-.81-3-.79-1.54.02-2.96.9-3.76 2.27-1.6 2.78-.41 6.9 1.15 9.16.76 1.1 1.67 2.34 2.86 2.3 1.15-.05 1.58-.74 2.97-.74 1.38 0 1.77.74 2.98.72 1.23-.02 2.01-1.12 2.76-2.23.87-1.28 1.23-2.52 1.25-2.58-.03-.01-2.39-.92-2.37-3.68zM14.1 5.86c.63-.77 1.06-1.83.94-2.89-.91.04-2.01.61-2.66 1.37-.58.67-1.09 1.75-.96 2.79 1.02.08 2.05-.52 2.68-1.27z" />
          </svg>
          App Store
        </a>
        <a href={playStore} class="pill-button light">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M3.6 1.8 13.4 12 3.6 22.2c-.4-.2-.6-.6-.6-1.1V2.9c0-.5.2-.9.6-1.1z" />
            <path d="m16.8 8.6-3.4 3.4 3.4 3.4 3.8-2.2c.8-.5.8-1.7 0-2.2z" opacity="0.75" />
            <path d="M3.6 1.8c.3-.2.8-.2 1.2 0l12 6.8-3.4 3.4z" opacity="0.55" />
            <path d="m13.4 12 3.4 3.4-12 6.8c-.4.2-.9.2-1.2 0z" opacity="0.9" />
          </svg>
          Google Play
        </a>
      </div>

      <div class="stage">
        <HeroStage />
      </div>
    </section>

    <FeatureCard
      id="features"
      title="Message your mates like teammates"
      body="Hand them tasks the way you’d text a friend. Your mates take projects from start to finish, remember how you work, get sharper over time, and check in when they need your OK."
    >
      <div slot="visual" class="big-mascot">
        <Mascot client:visible size={520} />
      </div>
    </FeatureCard>

    <Roles />

    <Team />

    <Computer />

    <Apps />
  </main>
</Base>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 40px;
    height: 72px;
    padding: 0 24px;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: saturate(180%) blur(16px);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  nav {
    display: flex;
    gap: 32px;
    font-size: 15px;
  }
  nav a {
    color: var(--text);
    transition: opacity 0.15s ease;
  }
  nav a:hover {
    opacity: 0.6;
  }
  .nav-cta {
    margin-left: auto;
    height: 44px;
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 36px 16px 0;
    text-align: center;
    overflow: hidden;
  }
  .announce {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 15px;
  }
  .announce strong {
    font-weight: 600;
  }
  .announce .dot {
    color: var(--muted);
  }
  .announce .arrow {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    margin-left: 6px;
    border-radius: 50%;
    background: var(--soft);
    font-size: 13px;
    transition: transform 0.15s ease;
  }
  .announce:hover .arrow {
    transform: translate(2px, -2px);
  }

  h1 {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.18em;
    margin: 28px 0 0;
    font-size: clamp(44px, 6.4vw, 76px);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
  }
  .inline-mascot {
    display: inline-flex;
    width: 0.92em;
    height: 0.92em;
  }
  .inline-mascot :global(span) {
    width: 100% !important;
    height: 100% !important;
  }
  .inline-mascot :global(svg) {
    width: 100%;
    height: 100%;
  }

  .lede {
    max-width: 68ch;
    text-wrap: balance;
    margin: 20px auto 0;
    color: var(--muted);
    font-size: clamp(16px, 1.6vw, 19px);
    line-height: 1.5;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 32px;
  }
  .ctas .pill-button {
    height: 50px;
    padding: 0 24px;
    font-size: 16px;
  }

  /* The phone rises out of the fold, cropped like a product shot. */
  .stage {
    position: relative;
    width: 100%;
    height: 640px;
    margin-top: 64px;
    display: flex;
    justify-content: center;
    -webkit-mask-image: linear-gradient(#000 78%, transparent);
    mask-image: linear-gradient(#000 78%, transparent);
  }
  .stage::before {
    content: "";
    position: absolute;
    top: 80px;
    width: min(900px, 100%);
    height: 480px;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 22%, transparent), transparent);
    filter: blur(20px);
  }
  /* Rises out of the panel's top edge; the panel crops its lower half. */
  .big-mascot {
    position: absolute;
    top: -70px;
    right: 6%;
    filter: drop-shadow(0 30px 40px rgba(15, 23, 42, 0.18));
  }

  @media (max-width: 860px) {
    .big-mascot {
      top: 0;
      right: auto;
      transform: scale(0.6);
      transform-origin: top center;
    }
    nav {
      display: none;
    }
    .nav {
      padding: 0 16px;
    }
    .hero {
      padding-top: 24px;
    }
    .announce {
      font-size: 14px;
    }
  }
  @media (max-width: 420px) {
    .stage {
      height: 570px;
      margin-top: 48px;
    }
    .stage > :global(*) {
      transform: scale(0.88);
      transform-origin: top center;
    }
  }
</style>
