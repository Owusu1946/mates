---
import Faq from "../components/Faq.astro";
import Workflows from "../components/Workflows.astro";
import LocalEdge from "../components/LocalEdge.astro";
import Footer from "../components/Footer.astro";
import HeroStage from "../components/HeroStage.astro";
import HeroMascot from "../components/HeroMascot";
import Logo from "../components/Logo.astro";
import MobileMenu from "../components/MobileMenu.astro";
import Pricing from "../components/Pricing.astro";
import Roles from "../components/Roles.astro";
import StoreButtons from "../components/StoreButtons.astro";
import Waitlist from "../components/Waitlist";
import Team from "../components/Team.astro";
import Apps from "../components/Apps.astro";
import BackToTop from "../components/BackToTop";
import Calls from "../components/Calls.astro";
import Meet from "../components/Meet.astro";
import Computer from "../components/Computer.astro";
import Base from "../layouts/Base.astro";

const nav = [
  { label: "Product", href: "#features" },
  { label: "Pricing", href: "#pricing" },
];
const api = import.meta.env.PUBLIC_API_URL ?? "https://mates-production.up.railway.app";
---

<Base skipToContent>
  <header class="nav">
    <a href="/" class="brand" aria-label="Mates home">
      <Logo size={28} />
      <span>mates</span>
    </a>
    <nav aria-label="Main">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <Waitlist client:load api={api} />
    <MobileMenu items={[...nav, { label: "FAQs", href: "#faq" }]} />
  </header>

  <main id="main-content" tabindex="-1">
    <section class="hero">
      <h1>
        Your AI team
        <span class="inline-mascot"><HeroMascot client:idle size={96} /></span>
        in your pocket
      </h1>

      <p class="lede">
        Research, routines, ride quotes, meeting notes, and pull requests — mates use the apps you connect and bring the work back.
      </p>

      <div class="hero-ctas">
        <StoreButtons />
      </div>

      <div class="stage">
        <HeroStage />
      </div>
    </section>

    <Workflows />

    <LocalEdge />

    <Roles />

    <Team />

    <Calls />

    <Meet />

    <Computer />

    <Apps />

    <Pricing />

    <Faq />

    <section class="launch" id="download" aria-labelledby="launch-title">
      <h2 id="launch-title">iPhone and Android, soon.</h2>
      <p>Join the waitlist. We’ll email you when it’s ready.</p>
      <StoreButtons />
    </section>
  </main>

  <Footer />
  <BackToTop client:idle />
</Base>

<style>
  .launch { width: min(640px, calc(100% - 40px)); margin: 112px auto 0; padding: 8px 0 32px; text-align: center; }
  .launch h2 { margin: 0; font-size: clamp(28px, 4vw, 42px); letter-spacing: -0.045em; line-height: 1.1; }
  .launch p { max-width: 36ch; margin: 14px auto 28px; color: var(--muted); font-size: 17px; line-height: 1.55; }
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 28px;
    height: 64px;
    padding: 0 28px;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    -webkit-backdrop-filter: saturate(160%) blur(18px);
    backdrop-filter: saturate(160%) blur(18px);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--display);
    font-size: 17px;
    font-weight: 560;
    letter-spacing: -0.03em;
  }
  nav {
    display: flex;
    gap: 22px;
    font-size: 14px;
  }
  nav a {
    color: var(--muted);
    transition: color 0.2s ease;
  }
  nav a:hover {
    color: var(--text);
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 48px 16px 0;
    text-align: center;
    overflow: hidden;
  }

  h1 {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.18em;
    margin: 0;
    font-size: clamp(40px, 7vw, 84px);
    font-weight: 560;
    letter-spacing: -0.055em;
    line-height: 0.96;
    animation: rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .inline-mascot {
    display: inline-flex;
    width: 0.92em;
    height: 0.92em;
  }
  .inline-mascot :global(span) {
    width: 100% !important;
    height: 100% !important;
  }
  .inline-mascot :global(svg) {
    width: 100%;
    height: 100%;
  }

  .lede {
    max-width: 42ch;
    text-wrap: balance;
    margin: 22px auto 0;
    color: var(--muted);
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.55;
    animation: rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.08s both;
  }
  .hero-ctas {
    margin-top: 28px;
    animation: rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.16s both;
  }
  .inline-mascot :global(.hero-mascot) {
    display: inline-flex;
    cursor: pointer;
  }

  /* The phone rises out of the fold, cropped like a product shot. */
  .stage {
    position: relative;
    width: 100%;
    height: 640px;
    margin-top: 56px;
    display: flex;
    justify-content: center;
    -webkit-mask-image: linear-gradient(#000 78%, transparent);
    mask-image: linear-gradient(#000 78%, transparent);
    animation: rise 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.22s both;
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }
  .stage::before {
    content: "";
    position: absolute;
    top: 80px;
    width: min(900px, 100%);
    height: 480px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(210, 126, 65, 0.22), transparent);
    filter: blur(20px);
  }
  @media (max-width: 860px) {
    nav {
      display: none;
    }
    .nav {
      height: 56px;
      padding: 0 16px;
    }
    .hero {
      padding-top: 28px;
    }
    .stage {
      margin-top: 40px;
    }
  }
  @media (max-width: 420px) {
    .stage {
      height: 570px;
      margin-top: 48px;
    }
    .stage > :global(*) {
      transform: scale(0.88);
      transform-origin: top center;
    }
  }
</style>
