---
import Mascot from "../components/Mascot";
import Faq from "../components/Faq.astro";
import Workflows from "../components/Workflows.astro";
import Control from "../components/Control.astro";
import Footer from "../components/Footer.astro";
import HeroStage from "../components/HeroStage.astro";
import Logo from "../components/Logo.astro";
import MobileMenu from "../components/MobileMenu.astro";
import Pricing from "../components/Pricing.astro";
import Roles from "../components/Roles.astro";
import StoreButtons from "../components/StoreButtons.astro";
import Waitlist from "../components/Waitlist";
import Team from "../components/Team.astro";
import Apps from "../components/Apps.astro";
import BackToTop from "../components/BackToTop";
import Calls from "../components/Calls.astro";
import Slack from "../components/Slack.astro";
// Coming soon, hidden until built: import PhoneCalls from "../components/PhoneCalls.astro";
// Coming soon, hidden until built: import Meet from "../components/Meet.astro";
// Coming soon, hidden until built: import Decks from "../components/Decks.astro";
// Coming soon, hidden until built: import More from "../components/More.astro";
import Computer from "../components/Computer.astro";
import Base from "../layouts/Base.astro";

const nav = [
  { label: "Features", href: "#features" },
  { label: "Missions", href: "#team" },
  { label: "Calls", href: "#calls" },
  { label: "Computer", href: "#computer" },
  { label: "Pricing", href: "#pricing" },
];
const api = import.meta.env.PUBLIC_API_URL ?? "https://mates-production.up.railway.app";
---

<Base>
  <header class="nav">
    <a href="/" class="brand" aria-label="Mates home">
      <Logo size={28} />
      <span>mates</span>
    </a>
    <nav aria-label="Main">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <Waitlist client:load api={api} />
    <MobileMenu items={[...nav, { label: "FAQs", href: "#faq" }]} />
  </header>

  <main>
    <section class="hero">
      <a href="#computer" class="announce">
        <strong>Mates can ship code now</strong>
        <span class="dot">·</span>
        <span class="more-link">See how it works</span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>

      <h1>
        Meet
        <span class="inline-mascot"><Mascot client:idle size={96} /></span>
        your mates
      </h1>

      <p class="lede">
        An AI team for everyday work. Research a decision, prepare a project, or set up a recurring task.
        Your mates work together across your connected apps and bring the results back to you.
      </p>

      <div class="hero-ctas">
        <StoreButtons />
      </div>

      <p class="demo-caption">Illustrative product demos · Mates is currently in development.</p>

      <div class="stage">
        <HeroStage />
      </div>
    </section>

    <Workflows />

    <Roles />

    <Team />

    <Calls />

    {/* Coming soon, hidden until built: <PhoneCalls /> */}

    {/* Coming soon, hidden until built: <Meet /> */}

    <Slack />

    {/* Coming soon, hidden until built: <Decks /> */}

    <Computer />

    <Control />

    <Apps />

    {/* Coming soon, hidden until built: <More /> */}

    <Pricing />

    <Faq />

    <section class="launch" id="download" aria-labelledby="launch-title">
      <Logo size={40} />
      <h2 id="launch-title">Meet your team when Mates launches.</h2>
      <p>Join the waitlist for iPhone and Android. We’ll email you when you can get started.</p>
      <StoreButtons />
    </section>
  </main>

  <Footer />
  <BackToTop client:idle />
</Base>

<style>
  .demo-caption { margin: 20px 0 0; color: var(--muted); font-size: 13px; line-height: 1.5; }
  .launch { width: min(760px, calc(100% - 40px)); margin: 120px auto 0; padding: 48px 0; text-align: center; }
  .launch h2 { margin: 20px 0 0; font-size: clamp(30px, 4vw, 48px); letter-spacing: -0.04em; line-height: 1.1; font-weight: 600; }
  .launch p { max-width: 48ch; margin: 20px auto 28px; color: var(--muted); font-size: 18px; line-height: 1.6; }
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 40px;
    height: 72px;
    padding: 0 24px;
    background: rgba(255, 255, 255, 0.82);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    backdrop-filter: saturate(180%) blur(16px);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  nav {
    display: flex;
    gap: 32px;
    font-size: 15px;
  }
  nav a {
    color: var(--text);
    transition: opacity 0.15s ease;
  }
  nav a:hover {
    opacity: 0.6;
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 36px 16px 0;
    text-align: center;
    overflow: hidden;
  }
  .announce {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 15px;
  }
  .announce strong {
    font-weight: 600;
  }
  .announce .dot {
    color: var(--muted);
  }
  .announce .arrow {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    margin-left: 6px;
    border-radius: 50%;
    background: var(--soft);
    font-size: 13px;
    transition: transform 0.15s ease;
  }
  .announce:hover .arrow {
    transform: translate(2px, -2px);
  }

  h1 {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.18em;
    margin: 28px 0 0;
    font-size: clamp(36px, 6.4vw, 76px);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
  }
  .inline-mascot {
    display: inline-flex;
    width: 0.92em;
    height: 0.92em;
  }
  .inline-mascot :global(span) {
    width: 100% !important;
    height: 100% !important;
  }
  .inline-mascot :global(svg) {
    width: 100%;
    height: 100%;
  }

  .lede {
    max-width: 68ch;
    text-wrap: balance;
    margin: 20px auto 0;
    color: var(--muted);
    font-size: clamp(16px, 1.6vw, 19px);
    line-height: 1.5;
  }
  .hero-ctas {
    margin-top: 32px;
  }

  /* The phone rises out of the fold, cropped like a product shot. */
  .stage {
    position: relative;
    width: 100%;
    height: 640px;
    margin-top: 64px;
    display: flex;
    justify-content: center;
    -webkit-mask-image: linear-gradient(#000 78%, transparent);
    mask-image: linear-gradient(#000 78%, transparent);
  }
  .stage::before {
    content: "";
    position: absolute;
    top: 80px;
    width: min(900px, 100%);
    height: 480px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(210, 126, 65, 0.22), transparent);
    filter: blur(20px);
  }
  @media (max-width: 860px) {
    nav {
      display: none;
    }
    .nav {
      padding: 0 16px;
    }
    .nav {
      height: 60px;
    }
    .hero {
      padding-top: 24px;
    }
    .announce {
      font-size: 14px;
    }
    h1 {
      margin-top: 22px;
    }
    .stage {
      margin-top: 48px;
    }
  }
  /* Phones: the announcement keeps just its headline and arrow. */
  @media (max-width: 520px) {
    .announce .dot,
    .announce .more-link {
      display: none;
    }
    .lede {
      margin-top: 16px;
    }
  }
  @media (max-width: 420px) {
    .stage {
      height: 570px;
      margin-top: 48px;
    }
    .stage > :global(*) {
      transform: scale(0.88);
      transform-origin: top center;
    }
  }
</style>
