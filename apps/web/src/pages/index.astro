---
import Mascot from "../components/Mascot";
import Base from "../layouts/Base.astro";

const nav = [
  { label: "Features", href: "#features" },
  { label: "Missions", href: "#missions" },
  { label: "Computer", href: "#computer" },
  { label: "Pricing", href: "#pricing" },
];
// Store links land here once the listings are live.
const appStore = "#download";
const playStore = "#download";
---

<Base>
  <header class="nav">
    <a href="/" class="brand" aria-label="Mates home">
      <Mascot client:idle size={30} />
      <span>mates</span>
    </a>
    <nav aria-label="Main">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a href="#download" class="pill-button dark nav-cta">Get the app</a>
  </header>

  <main>
    <section class="hero">
      <a href="#computer" class="announce">
        <strong>Mates can ship code now</strong>
        <span class="dot">·</span>
        <span>See how it works</span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>

      <h1>
        Meet
        <span class="inline-mascot"><Mascot client:idle size={96} /></span>
        Mates
      </h1>

      <p class="lede">
        AI teammates in your pocket. Give them real work, they plan it, hand it off to each other, and come back with
        it finished.
      </p>

      <div class="ctas">
        <a href={appStore} class="pill-button dark">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M16.37 12.6c-.02-2.3 1.88-3.4 1.96-3.46-1.07-1.56-2.73-1.77-3.32-1.8-1.41-.14-2.76.83-3.48.83-.72 0-1.82-.81-3-.79-1.54.02-2.96.9-3.76 2.27-1.6 2.78-.41 6.9 1.15 9.16.76 1.1 1.67 2.34 2.86 2.3 1.15-.05 1.58-.74 2.97-.74 1.38 0 1.77.74 2.98.72 1.23-.02 2.01-1.12 2.76-2.23.87-1.28 1.23-2.52 1.25-2.58-.03-.01-2.39-.92-2.37-3.68zM14.1 5.86c.63-.77 1.06-1.83.94-2.89-.91.04-2.01.61-2.66 1.37-.58.67-1.09 1.75-.96 2.79 1.02.08 2.05-.52 2.68-1.27z" />
          </svg>
          App Store
        </a>
        <a href={playStore} class="pill-button light">
          <svg width="17" height="17" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#34A853" d="M3.6 1.8 13.4 12 3.6 22.2c-.4-.2-.6-.6-.6-1.1V2.9c0-.5.2-.9.6-1.1z" />
            <path fill="#FBBC04" d="m16.8 8.6-3.4 3.4 3.4 3.4 3.8-2.2c.8-.5.8-1.7 0-2.2z" />
            <path fill="#4285F4" d="M3.6 1.8c.3-.2.8-.2 1.2 0l12 6.8-3.4 3.4z" />
            <path fill="#EA4335" d="m13.4 12 3.4 3.4-12 6.8c-.4.2-.9.2-1.2 0z" />
          </svg>
          Google Play
        </a>
      </div>

      <div class="stage" aria-hidden="true">
        <div class="phone">
          <div class="island"></div>
          <div class="screen">
            <div class="chat-head">
              <div class="faces">
                <span style="--g: linear-gradient(135deg,#e5c59e,#d27e41,#9a3412)"></span>
                <span style="--g: linear-gradient(135deg,#bfe3ff,#5b8def,#1e3a8a)"></span>
                <span style="--g: linear-gradient(135deg,#d9f99d,#4ade80,#166534)"></span>
              </div>
              <div>
                <div class="chat-title">Launch week</div>
                <div class="chat-sub">Cooper, Nova, Ivy</div>
              </div>
            </div>

            <div class="bubble me">Ship dark mode in the app and get the release notes ready.</div>

            <div class="msg">
              <span class="face" style="--g: linear-gradient(135deg,#e5c59e,#d27e41,#9a3412)"></span>
              <div class="bubble them">On it. Nova takes the code, Ivy writes the notes.</div>
            </div>

            <div class="card handoff">
              <span class="label">Handoff</span>
              Cooper <span class="to">→</span> Nova · Build dark mode
            </div>

            <div class="card code">
              <span class="label">Mates’ computer</span>
              <div class="repo">acme/app</div>
              <div class="check">✓ pnpm typecheck</div>
              <div class="check">✓ pnpm test</div>
              <div class="pr">PR #42 opened by mates[bot]</div>
            </div>

            <div class="card note">
              <span class="label">Note · Ivy</span>
              Release notes v2.4
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 40px;
    height: 72px;
    padding: 0 28px;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: saturate(180%) blur(16px);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  nav {
    display: flex;
    gap: 32px;
    font-size: 16px;
  }
  nav a {
    color: #1d1d1f;
    transition: opacity 0.15s ease;
  }
  nav a:hover {
    opacity: 0.6;
  }
  .nav-cta {
    margin-left: auto;
    height: 44px;
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 36px 16px 0;
    text-align: center;
    overflow: hidden;
  }
  .announce {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 16px;
  }
  .announce strong {
    font-weight: 600;
  }
  .announce .dot {
    color: var(--muted);
  }
  .announce .arrow {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    margin-left: 6px;
    border-radius: 50%;
    background: var(--soft);
    font-size: 13px;
    transition: transform 0.15s ease;
  }
  .announce:hover .arrow {
    transform: translate(2px, -2px);
  }

  h1 {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.18em;
    margin: 28px 0 0;
    font-size: clamp(56px, 9vw, 104px);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
  }
  .inline-mascot {
    display: inline-flex;
    width: 0.92em;
    height: 0.92em;
  }
  .inline-mascot :global(span) {
    width: 100% !important;
    height: 100% !important;
  }
  .inline-mascot :global(svg) {
    width: 100%;
    height: 100%;
  }

  .lede {
    max-width: 40ch;
    margin: 28px auto 0;
    color: var(--muted);
    font-size: clamp(18px, 2.2vw, 24px);
    line-height: 1.5;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 40px;
  }
  .ctas .pill-button {
    height: 56px;
    padding: 0 28px;
    font-size: 18px;
  }

  /* The phone rises out of the fold, cropped like a product shot. */
  .stage {
    position: relative;
    width: 100%;
    height: 560px;
    margin-top: 72px;
    display: flex;
    justify-content: center;
    -webkit-mask-image: linear-gradient(#000 70%, transparent);
    mask-image: linear-gradient(#000 70%, transparent);
  }
  .stage::before {
    content: "";
    position: absolute;
    top: 80px;
    width: min(900px, 100%);
    height: 480px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(210, 126, 65, 0.22), transparent);
    filter: blur(20px);
  }
  .phone {
    position: relative;
    width: 340px;
    height: 700px;
    padding: 12px;
    border-radius: 56px;
    background: #111;
    box-shadow: 0 40px 80px -20px rgba(0, 0, 0, 0.35), inset 0 0 0 2px #2a2a2a;
  }
  .island {
    position: absolute;
    top: 24px;
    left: 50%;
    width: 96px;
    height: 28px;
    border-radius: 20px;
    background: #000;
    transform: translateX(-50%);
    z-index: 1;
  }
  .screen {
    height: 100%;
    padding: 68px 16px 16px;
    border-radius: 44px;
    background: #fff;
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-align: left;
    font-size: 14px;
    line-height: 1.4;
  }
  .chat-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
  }
  .faces {
    display: flex;
  }
  .faces span,
  .face {
    width: 26px;
    height: 26px;
    flex: none;
    border-radius: 50%;
    background: var(--g);
    border: 2px solid #fff;
  }
  .faces span + span {
    margin-left: -9px;
  }
  .chat-title {
    font-weight: 600;
  }
  .chat-sub {
    color: var(--muted);
    font-size: 12px;
  }
  .bubble {
    padding: 9px 13px;
    border-radius: 18px;
    max-width: 82%;
  }
  .bubble.me {
    align-self: flex-end;
    background: var(--text);
    color: #fff;
    border-bottom-right-radius: 6px;
  }
  .msg {
    display: flex;
    gap: 8px;
    align-items: flex-end;
  }
  .bubble.them {
    background: var(--soft);
    border-bottom-left-radius: 6px;
  }
  .card {
    padding: 11px 13px;
    border-radius: 16px;
    border: 1px solid var(--line);
    font-size: 13px;
  }
  .card .label {
    display: block;
    margin-bottom: 4px;
    color: var(--muted);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .handoff .to {
    color: var(--accent);
  }
  .code .repo {
    font-weight: 600;
    margin-bottom: 4px;
  }
  .code .check {
    color: #30a46c;
    font-family: ui-monospace, Menlo, monospace;
    font-size: 12px;
  }
  .code .pr {
    margin-top: 8px;
    padding: 8px 10px;
    border-radius: 10px;
    background: var(--soft);
    font-weight: 600;
  }

  @media (max-width: 860px) {
    nav {
      display: none;
    }
    .nav {
      padding: 0 16px;
    }
    .hero {
      padding-top: 24px;
    }
    .announce {
      font-size: 14px;
    }
  }
</style>
