# Only public values: the bundle ships to everyone. Secrets stay in apps/api (AGENTS.md).

# Clerk publishable key, the same instance as the phone (EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY)
VITE_CLERK_PUBLISHABLE_KEY=
# The Frontend API host from Clerk's API keys page, without https:// (e.g. clerk.askorin.app,
# or your-slug.clerk.accounts.dev in development). The CSP allows it.
VITE_CLERK_FRONTEND_API_HOST=
# The API (EXPO_PUBLIC_API_URL on the phone)
VITE_API_URL=
