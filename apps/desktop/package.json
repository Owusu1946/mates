{
  "name": "@muse-clone/desktop",
  "productName": "Mates",
  "version": "0.1.0",
  "description": "Mates for desktop: your crew on Windows, macOS and Linux",
  "author": "Mates",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "typecheck": "tsrs -p tsconfig.node.json --noEmit && tsrs -p tsconfig.web.json --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@muse-clone/mascot": "workspace:*",
    "@pierre/diffs": "1.7.1",
    "@tailwindcss/vite": "~4.3.5",
    "@types/node": "^24.19.1",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@vitejs/plugin-react": "^6.2.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.11.5",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "oxc-transform-react": "~0.156.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "~4.3.5",
    "tsrs": "7.1.0-beta.tsrs5",
    "vite": "^8.3.6"
  }
}
