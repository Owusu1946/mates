# Server-only secrets for apps/api. Never copy these into apps/mobile or apps/web.

# --- Core (required) -------------------------------------------------------
# Pooled Neon URL for application traffic
DATABASE_URL=
# Direct (unpooled) Neon URL for migrations
DIRECT_DATABASE_URL=
CLERK_SECRET_KEY=
# Optional. Defaults to 3000.
PORT=
# Web origins allowed by CORS, comma-separated (native apps don't need this). Default http://localhost:8081
ALLOWED_ORIGINS=

# --- AI models (OpenRouter) ------------------------------------------------
OPENROUTER_API_KEY=
# Mints a capped, short-lived key per coding run so the sandbox never holds the main key
OPENROUTER_PROVISIONING_KEY=
# Optional model overrides (OpenRouter model ids); sensible defaults live in src/models.ts
OPENROUTER_CHAT_MODEL=
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_CODE_MODEL=
OPENROUTER_PLANNER_MODEL=
OPENROUTER_MEMORY_MODEL=
OPENROUTER_VISION_MODEL=
OPENROUTER_EMBEDDING_MODEL=
# Optional spend cap per coding run, in USD. Default 3
CODE_RUN_LIMIT_USD=

# --- Background work (Trigger.dev) -----------------------------------------
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=
# Set true only after migrations and registered/deployed workers are verified
COOPER_BACKGROUND_ENABLED=false

# --- Integrations ----------------------------------------------------------
# Server-only Composio project key for app connections and tools
COMPOSIO_API_KEY=
# Server-only cloud browser and browser inference credentials
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Web search and page reading (docs.parallel.ai). Without it, search falls back to Browserbase.
PARALLEL_API_KEY=
# Voice typing in the composer (Deepgram Nova-3, deepgram.com)
DEEPGRAM_API_KEY=
# Sandboxed computers for coding runs (modal.com)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- GitHub App (code runs open PRs) ----------------------------------------
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The app's private key PEM. Locally, keep it on one line with \n for newlines.
GITHUB_APP_PRIVATE_KEY=
# Optional. Signs install state; falls back to CLERK_SECRET_KEY
GITHUB_STATE_SECRET=

# --- Voice calls (LiveKit Cloud: cloud.livekit.io) -----------------------
# The phone joins a LiveKit room; the voice agent (voice-agent/) speaks for the mates.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional. Signs the per-call token the voice agent uses; falls back to CLERK_SECRET_KEY
CALL_TOKEN_SECRET=
# Optional. Must match agentName in voice-agent/src/main.ts. Default mates-voice
LIVEKIT_AGENT_NAME=

# --- Slack app (mates in Slack: api.slack.com/apps) ------------------------
# From the app's Basic Information page. The manifest lives in slack/manifest.json.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Verifies that events, commands and button clicks really come from Slack
SLACK_SIGNING_SECRET=
# Encrypts each workspace's bot token at rest: 32 random bytes, base64 (openssl rand -base64 32)
SLACK_TOKEN_KEY=
# Optional. Signs install and account-link state; falls back to CLERK_SECRET_KEY
SLACK_STATE_SECRET=
# Optional. This API's public address, for the "Connect Mates" button. Default https://mates-production.up.railway.app
API_PUBLIC_URL=
# Optional. The landing site serving the mates' pictures (/mates/<shape>-<colour>.png). Default https://agents.askorin.app
SITE_URL=

# --- Meetings (Recall.ai: mates join Google Meet) --------------------------
# API key from recall.ai; keys only work in the region they were created in
RECALL_API_KEY=
# The key's region: us-west-2, us-east-1, eu-central-1 or ap-northeast-1
RECALL_REGION=
# Verifies Recall's webhooks: Developers → API Keys & Secrets → Create Workspace Secret (starts whsec_).
# Point Recall's webhook at https://<api>/v1/recall/webhook
RECALL_WEBHOOK_SECRET=

# --- Notifications ---------------------------------------------------------
# Optional: if Expo push access-token security is enabled for the EAS project
EXPO_ACCESS_TOKEN=

# --- Landing page (apps/web) -------------------------------------------------
# Origins allowed to post visits and waitlist sign-ups. Default https://agents.askorin.app,http://localhost:4321
SITE_ORIGINS=
# Salt for the cookie-free daily visitor hash. Set any long random string in production
VISIT_SALT=
