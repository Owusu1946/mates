# Public API base URL embedded in the mobile bundle. Never place secrets here.
EXPO_PUBLIC_API_URL=
# Clerk publishable key (safe for the app bundle)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# RevenueCat public SDK keys. The Test Store key is used only by development builds.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_TEST_KEY=
# Sentry DSN for mobile error reporting
EXPO_PUBLIC_SENTRY_DSN=
# Sentry auth token for EAS source map uploads (CI secret, not bundled)
SENTRY_AUTH_TOKEN=
# Sentry organization slug for source map uploads
SENTRY_ORG=
# Sentry project slug for source map uploads
SENTRY_PROJECT=
