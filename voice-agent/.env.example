# Copy to .env.local for `lk agent dev`. On LiveKit Cloud, LIVEKIT_* are provided for you and
# MATES_API_URL is set as a secret: lk agent create --secrets MATES_API_URL=https://your-api
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# The Mates API this agent reports to (no trailing slash).
MATES_API_URL=
# Must match the API's LIVEKIT_AGENT_NAME (default mates-voice).
LIVEKIT_AGENT_NAME=mates-voice
